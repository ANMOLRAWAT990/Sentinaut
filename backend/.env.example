# SentiNaut Backend Environment Variables Example
# Copy this file to .env and fill in your values.

# Server Configuration
HOST=127.0.0.1
PORT=8000

# Database (Mock setup for now, actual DB in Week 5)
DATABASE_URL=sqlite:///./sentinaut.db

# API Keys
GEMINI_API_KEY=your_gemini_api_key_here
USE_GEMINI=true
